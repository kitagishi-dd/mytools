{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/kitagishi/.codex/hooks/pre_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/kitagishi/.codex/hooks/pre_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
