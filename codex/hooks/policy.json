{
  "bash_deny": [
    "cat .env*",
    "cat *.env",
    "cat *.env.*",
    "sudo",
    "sudo *",
    "rm -rf /",
    "rm -rf /*",
    "rm -rf ~",
    "rm -rf ~/*",
    "rm -rf $HOME*",
    "dd if=*",
    "dd of=*",
    "mkfs *",
    "mkfs.*",
    "fdisk *",
    "parted *",
    "shutdown",
    "shutdown *",
    "reboot",
    "reboot *",
    "halt",
    "halt *",
    "poweroff",
    "poweroff *",
    "init 0",
    "init 6",
    "systemctl poweroff*",
    "systemctl reboot*",
    "systemctl halt*",
    "pip install *",
    "pip3 install *",
    "pip uninstall *",
    "pip3 uninstall *",
    "python -m pip install *",
    "python3 -m pip install *",
    "conda install *",
    "conda create *",
    "conda env *",
    "conda remove *",
    "conda update *",
    "mamba install *",
    "mamba create *",
    "apt install *",
    "apt remove *",
    "apt purge *",
    "apt update*",
    "apt upgrade*",
    "apt-get install *",
    "apt-get remove *",
    "apt-get purge *",
    "apt-get update*",
    "apt-get upgrade*",
    "yum install *",
    "yum remove *",
    "dnf install *",
    "dnf remove *",
    "npm install *",
    "npm i *",
    "npm install",
    "npm i",
    "npm uninstall *",
    "npm rm *",
    "npm update *",
    "yarn add *",
    "yarn install*",
    "yarn remove *",
    "yarn upgrade *",
    "pnpm add *",
    "pnpm install*",
    "pnpm i *",
    "pnpm remove *",
    "pnpm update *",
    "gem install *",
    "gem uninstall *",
    "cargo install *",
    "cargo uninstall *",
    "go install *",
    "brew install *",
    "brew uninstall *",
    "brew update*",
    "brew upgrade*"
  ],
  "bash_allow": [
    "git status *",
    "git branch *",
    "git log *",
    "git diff *",
    "git show *",
    "git blame *",
    "git remote *",
    "git ls-files *",
    "git rev-parse *",
    "git reflog *",
    "git describe *",
    "git stash list",
    "git stash show *",
    "git tag -l*",
    "git tag --list *",
    "git for-each-ref *",
    "git config --get*",
    "git config --list*",
    "gh pr view *",
    "gh pr list *",
    "gh pr diff *",
    "gh issue view *",
    "gh issue list *",
    "gh repo view *",
    "ls *",
    "ls",
    "pwd",
    "tree *",
    "cat *",
    "grep *",
    "rg *",
    "find *",
    "head *",
    "tail *",
    "wc *",
    "diff *",
    "sort *",
    "uniq *",
    "cut *",
    "sed -n *",
    "file *",
    "stat *",
    "which *",
    "type *",
    "echo *",
    "printf *",
    "date *",
    "whoami",
    "id",
    "hostname",
    "uname *",
    "df *",
    "du *",
    "free *",
    "ps *",
    "realpath *",
    "readlink *",
    "basename *",
    "dirname *",
    "md5sum *",
    "sha256sum *",
    "sha1sum *",
    "jq *",
    "yq *",
    "xxd *",
    "od *",
    "strings *"
  ],
  "tool_allow": [
    "Read",
    "Glob",
    "Grep",
    "Edit",
    "Write",
    "MultiEdit",
    "NotebookEdit"
  ]
}
